# AgentForge — copy to .env. Never commit .env.

# --- Target project (this Task Manager is target #1; point these at another clone later) ---
TARGET_REPO_PATH=..
GITHUB_OWNER=junaidyounispersonal
GITHUB_REPO=task-manager
GITHUB_DEFAULT_BRANCH=main
GITHUB_REPO_ALLOWLIST=junaidyounispersonal/task-manager

# Check commands run from TARGET_REPO_PATH. Leave empty to skip.
# CHECK_LINT_SCOPE=changed (default) lints only files AgentForge changed, so pre-existing
# frontend lint debt does not block a PR. Use "all" to run CHECK_LINT against the whole tree.
CHECK_LINT=npm --prefix frontend run lint
CHECK_LINT_SCOPE=changed
CHECK_BUILD=npm --prefix frontend run build
CHECK_TEST=

# --- GitHub (fine-grained PAT or GitHub App installation token; repo-scoped) ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Server ---
AGENTFORGE_PORT=5055
AGENTFORGE_HOST=127.0.0.1
LOG_LEVEL=info

# --- AI provider ---
AI_AGENT_PROVIDER=hermes
HERMES_BIN=hermes
# Optional. Leave empty unless those Hermes skills are actually installed.
HERMES_SKILLS=
HERMES_TIMEOUT_MS=600000

# Never set this true. Hermes --yolo is forbidden.
HERMES_YOLO=false

# After implementation, if lint/test/build fail, Hermes retries this many times with the check output.
# GitHub Actions CI diagnosis stays comment-only (no auto-edit).
MAX_AUTO_FIX_ATTEMPTS=2

# Git commits created by AgentForge after human plan approval
AGENTFORGE_GIT_USER_NAME=AgentForge
AGENTFORGE_GIT_USER_EMAIL=agentforge@local
